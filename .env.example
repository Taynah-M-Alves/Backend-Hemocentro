# Copie para .env (cp .env.example .env). O backend, o Prisma e o script do primeiro gestor
# leem o .env da pasta onde são executados. Explicação de cada variável: DEPLOY.md.

# PostgreSQL. Caracteres especiais na senha precisam de URL-encode (@ vira %40).
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/hemocentro

# production: sem SMTP_HOST, o esqueci-senha dá erro. development: o link do e-mail aparece no log.
NODE_ENV=production
PORT=3000

# ─── IA que lê as fichas (pelo menos uma) ───────────────────────────────────
# Ordem de tentativa: Gemini → Groq → OpenRouter → OpenAI.
# Sem a chave, aquela IA é pulada. Os *_MODEL são opcionais (os valores abaixo são o padrão).
GEMINI_API_KEY=
# Lista separada por vírgula: o próximo modelo só é tentado quando o anterior dá 503 (sobrecarga)
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-2.5-flash
# Groq: precisa de um modelo com visão (aceita até 5 páginas por ficha)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OpenRouter: chave começa com sk-or-v1. Modelo no formato empresa/modelo.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ─── Frontend ───────────────────────────────────────────────────────────────
# Origens que podem chamar a API (CORS), separadas por vírgula. Sem a variável, libera 8080 e 8081.
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

# Fuso das datas em mensagens e planilhas (o JSON continua em UTC, com "Z"). Padrão: America/Cuiaba.
FUSO_HORARIO=America/Cuiaba

# Servidor atrás de proxy (nginx, IIS, balanceador): quantos proxies há na frente (ex.: 1) ou os IPs deles.
# Serve para o limite de tentativas de login enxergar o IP de quem chamou. Sem proxy, deixe vazio.
# Não use "true": qualquer um poderia inventar o próprio IP no header X-Forwarded-For.
TRUST_PROXY=

# ─── E-mail (esqueci a senha) ───────────────────────────────────────────────
# Endereço da tela Redefinir senha no frontend; o link do e-mail é FRONTEND_URL/redefinir-senha?token=...
FRONTEND_URL=http://localhost:8080
# SMTP usado pelo nodemailer. Porta 465 = SSL; 587 = STARTTLS. Gmail: smtp.gmail.com com "senha de app".
# Sem SMTP_HOST, fora de produção, o e-mail aparece no terminal do backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=Hemocentro <nao-responda@hemocentro.local>
